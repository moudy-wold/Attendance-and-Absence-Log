# Copy to .env (same folder as docker-compose.yml). Never commit the real .env file.
# Used both for docker-compose variable substitution and injected into the
# backend container's environment.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False

# Comma-separated list, e.g. api.example.com,example.com
ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=attendance
POSTGRES_USER=attendance
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://attendance:change-me@db:5432/attendance

# Only needed if the web app is ever served from a different origin than the
# API (not the case with the bundled nginx service, which proxies same-origin).
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

GUNICORN_WORKERS=3
